[
  // Keep Vim for editing. Let Zed handle the workspace and project layer.
  {
    "context": "Pane && !Terminal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "Dock && !Terminal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // Vim owns Ctrl-F in normal mode, so override it at the editor context.
      "ctrl-f": ["task::Spawn", { "task_name": "Open Project" }],
      // Esc still exits insert mode; in normal mode it closes the active file tab.
      "escape": "pane::CloseActiveItem"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      // Use the same key to show and hide the file explorer.
      "cmd-shift-e": "project_panel::Toggle",
      // Keep the parent-folder finder for projects that are not open yet.
      "ctrl-shift-o": ["task::Spawn", { "task_name": "Open Project" }],
      // With two projects, previous project is the quick toggle between them.
      "ctrl-b L": "multi_workspace::PreviousProject"
    }
  }
]
