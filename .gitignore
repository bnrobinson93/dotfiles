# herdr rewrites this on every integration update; managed there, not here.
ai/dot-claude/hooks/herdr-agent-state.sh

# Codex runtime state. On machines still carrying the old layout, ~/.codex is a
# symlink into ai/dot-codex, so Codex writes its databases, caches, session logs,
# and system-installed skills straight into the repo, and it invents new ones on
# every upgrade. Ignore the directory and allow back only the three seed files;
# a new config file needs a line here before it can be tracked.
ai/dot-codex/*
!ai/dot-codex/config.toml
!ai/dot-codex/herdr-agent-state.sh
!ai/dot-codex/hooks.json

# ~/.config/atuin is the whole atuin/ dir symlinked in; atuin writes its own
# runtime files (receipts, etc.) alongside config.toml. Only track the config.
atuin/*
!atuin/config.toml
kitty/__pycache__/
