# Guarded on interactive: these shadow standard command names, and agent tool
# calls source this file explicitly, so they must see real POSIX behavior.
if [[ -o interactive ]]; then
  alias vi=$EDITOR

  # uu-cut's -c counts bytes where GNU counts characters, so multibyte input
  # truncates differently - accepted, it matches how Go indexes strings. sort is
  # excluded: slower than GNU, and its collation changes sort | uniq output.
  for _uu in uniq tac base64 cut; do
    (( $+commands[uu-$_uu] )) && alias $_uu="uu-$_uu"
  done
  unset _uu

  alias clera=clear
  alias cler=clear
  alias claer=clear
  alias ..='cd ..'
  alias ...='cd ../..'
  alias ....='cd ../../..'
fi

if type atuin >/dev/null 2>&1; then
  [[ -f "$HOME/.atuin/bin/env" ]] && . "$HOME/.atuin/bin/env"
  atuin_cache="$HOME/.cache/zsh/atuin_init.zsh"
  if [[ ! -f "$atuin_cache" || "$(command -v atuin)" -nt "$atuin_cache" ]]; then
    atuin init zsh --disable-up-arrow > "$atuin_cache" 2>/dev/null
