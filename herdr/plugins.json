        "title": "Remove jw workspace",
        "contexts": [
          "workspace"
        ],
        "command": [
          "./target/release/herdr-jj-waltz",
          "open",
          "remove"
        ]
      }
    ],
    "panes": [
      {
        "id": "create",
        "title": "New jw workspace",
        "placement": "overlay",
        "command": [
