+// jj (colocated): the working copy @ against its parent, which is git's HEAD. `diff HEAD`
+// compares the files with HEAD directly, so whatever git's index holds (jj doesn't keep
+// it, and a git merge can leave it half-staged) never shows. Every file is one group.
+export async function readJjStatus(git) {
+  const numstat = await git(["diff", "HEAD", "--numstat", "-z", ...NO_HELPERS]);
+  const names = await git(["diff", "HEAD", "--name-status", "-z", ...NO_HELPERS]);
+  const fresh = await git(["ls-files", "--others", "--exclude-standard", "-z"]);
+  if (numstat.code !== 0 || names.code !== 0 || fresh.code !== 0)
+    throw Error(numstat.stderr || names.stderr || fresh.stderr || "Cannot read changes");
+  const none = { add: 0, del: 0 };
+  const file = (path, status, stats, isFresh) => ({
+    path,
+    fresh: isFresh,
+    conflict: false,
+    conflictKind: null,
+    staged: false,
+    unstaged: true,
+    status,
+    stagedStatus: " ",
+    unstagedStatus: status,
+    stagedStats: none,
+    unstagedStats: stats,
+    add: stats.add,
+    del: stats.del,
+    binary: Boolean(stats.binary),
+  });
+  const tracked = commitFiles(numstat.stdout, names.stdout).map((f) =>
+    file(f.path, f.status, { add: f.add, del: f.del, binary: f.binary }, false),
+  );
+  const known = new Set(tracked.map((f) => f.path));
+  const added = fresh.stdout
+    .split("\0")
+    .filter((path) => path && !known.has(path))
+    .map((path) => file(path, "A", none, true));
+  return {
+    files: [...tracked, ...added].sort((a, b) => a.path.localeCompare(b.path)),
+    hasHead: true,
+  };
+}
+
+// jj: the nearest local bookmark at or below @, else @'s change id. No snapshot.
+export async function readJjBookmark(jj) {
+  const T = 'change_id.shortest(8) ++ "\\t" ++ local_bookmarks.map(|b| b.name()).join(" ") ++ "\\n"';
+  const near = await jj(["log", "-r", "heads(::@ & bookmarks())", "--no-graph", "-T", T]);
+  const bookmark = near?.code === 0 ? near.stdout.split("\n")[0]?.split("\t")[1]?.split(" ")[0] : null;
+  if (bookmark) return bookmark;
+  const at = await jj(["log", "-r", "@", "--no-graph", "-T", T]);
+  const id = at?.code === 0 ? at.stdout.split("\t")[0].trim() : "";
+  return id ? `@${id}` : null;
+}
