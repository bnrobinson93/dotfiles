#!/bin/bash
# Regenerate swaync panel colors from the active Omarchy theme's mako.ini, then reload.
# Keeps SwayNotificationCenter recoloring in step with `omarchy theme set`.

mako_ini="$HOME/.config/omarchy/current/theme/mako.ini"
out="$HOME/.config/swaync/colors.css"
[ -f "$mako_ini" ] || exit 0
[ -e "$out" ] || exit 0

fg=$(grep -oP 'text-color=\K#[0-9a-fA-F]{6}' "$mako_ini")
accent=$(grep -oP 'border-color=\K#[0-9a-fA-F]{6}' "$mako_ini")
bg=$(grep -oP 'background-color=\K#[0-9a-fA-F]{6}' "$mako_ini")

cat > "$out" <<EOF
/* Regenerated by ~/.config/omarchy/hooks/theme-set from the active theme's mako.ini. */
@define-color bg ${bg:-#1e1e2e};
@define-color fg ${fg:-#cdd6f4};
@define-color accent ${accent:-#89b4fa};
EOF

swaync-client -rs -sw 2>/dev/null || true
