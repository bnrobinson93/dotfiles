{
  "version": 1,
  "remove": ["omarchy.menu"],
  "idle": {
    "screensaver": 300,
    "lock": 900
  },
  "bar": {
    "transparent": true,
    "layout": {
      "left": [{ "id": "menu-button" }, { "id": "omarchy.workspaces" }],
      "center": [
        { "id": "omarchy.indicators" },
        { "id": "orientation", "monitor": "eDP-1" },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM HH:mm"
        },
        { "id": "ticktick" },
        { "id": "omarchy.keyboard-layout" },
        { "id": "omarchy.weather" },
        { "id": "camera" },
        { "id": "omarchy.media" },
        { "id": "omarchy.system-update" }
      ],
      "right": [
        { "id": "omarchy.tray" },
        { "id": "omarchy.tailscale" },
        { "id": "omarchy.agents" },
        { "id": "omarchy.bluetooth" },
        { "id": "omarchy.network" },
        { "id": "omarchy.audio" },
        { "id": "omarchy.monitor" },
        { "id": "omarchy.power" }
      ]
    }
  },
  "plugins": [{ "id": "idle-ladder" }, { "id": "ticktick-quick-add" }]
}
