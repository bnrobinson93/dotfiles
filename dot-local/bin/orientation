#!/usr/bin/env bash
# Screen auto-rotate control for Hyprland via the accelerometer.
#
# iio-hyprland is unusable here: it drives rotation through `hyprctl keyword`,
# which Hyprland's Lua config parser refuses outright ("keyword can't work with
# non-legacy parsers. Use eval."). So this script is its own daemon — it reads
# orientation from iio-sensor-proxy (`monitor-sensor`) and applies the rotation
# by evaluating the same `hl.monitor`/`hl.config` calls the config file uses.
#
# Auto-rotate is a backgrounded daemon. "Lock" kills it (freezes orientation);
# "unlock" restarts it (re-syncs to current physical orientation).
#
# Lock state is an Omarchy toggle rather than a flag file of this script's own.
# `omarchy-toggle` is generic -- it touches ~/.local/state/omarchy/toggles/<name>
# for any name -- so rotate lock gets the same home, CLI, and Trigger > Toggle
# menu row as night light and do not disturb, and persists across a reboot. The
# `-off` suffix is Omarchy's convention: the flag names the disabled state.
#
# Subcommands:
#   start   - launch daemon unless locked or already running
#   stop    - kill daemon (freeze current orientation)
#   toggle  - flip locked/auto
#   status  - emit Waybar-style JSON (icon + class + tooltip). Nothing on the
#             bar reads it any more -- the brad.orientation widget reads the
#             toggle directly -- but it stays as the CLI's way to report state
#   _daemon - internal: the sensor loop (do not call directly)

set -euo pipefail

MONITOR="eDP-1"
RUNDIR="${XDG_RUNTIME_DIR:-/tmp}"
TOGGLE="autorotate-off"
PIDFILE="$RUNDIR/orientation-daemon.pid"

# Nerd Font (Material Design) glyphs
ICON_AUTO="󰑵"   # screen-rotation
ICON_LOCK="󰍁"   # lock

SELF="$(command -v "$0" 2>/dev/null || readlink -f "$0")"

is_locked() { omarchy-toggle-enabled "$TOGGLE"; }
running()   { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

# Map iio-sensor-proxy orientation -> Hyprland transform.
# Hyprland: 0=normal 1=90° 2=180° 3=270°. Swap left-up/right-up if portrait
# comes out upside-down for your hardware.
map_transform() {
  case "$1" in
    normal)    echo 0 ;;
    left-up)   echo 1 ;;
    bottom-up) echo 2 ;;
    right-up)  echo 3 ;;
    *)         echo "" ;;
  esac
}

apply() {
  local t="$1" scale
  scale=$(hyprctl monitors -j all | jq -r --arg m "$MONITOR" '.[]|select(.name==$m)|.scale')
  case "$scale" in ''|null) scale=1 ;; esac
  hyprctl eval "
    hl.monitor({ output = '$MONITOR', mode = 'preferred', position = 'auto', scale = $scale, transform = $t })
    hl.config({ input = { touchdevice = { transform = $t }, tablet = { transform = $t } } })
  " >/dev/null 2>&1 || true
}

_daemon() {
  echo "$$" >"$PIDFILE"
  trap 'rm -f "$PIDFILE"; kill 0' EXIT
  # monitor-sensor prints the initial orientation then "changed:" lines.
  stdbuf -oL monitor-sensor 2>/dev/null | while IFS= read -r line; do
    o=$(printf '%s' "$line" | sed -nE 's/.*(changed|orientation): ([a-z-]+).*/\2/p')
    [ -z "$o" ] && continue
    t=$(map_transform "$o")
    [ -n "$t" ] && apply "$t"
  done
}

start() {
  is_locked && return 0
  running && return 0
  # setsid -> daemon is its own process-group leader (PGID == its PID), so stop
  # can kill the whole group (daemon + monitor-sensor child).
  setsid "$SELF" _daemon >/dev/null 2>&1 </dev/null &
}

stop() {
  if running; then
    kill -- -"$(cat "$PIDFILE")" 2>/dev/null || true
  fi
  rm -f "$PIDFILE"
}

toggle() {
  omarchy-toggle "$TOGGLE"

  # Notify the way Omarchy's own toggle commands do, so this reads as one of
  # them from the menu.
  if is_locked; then
    stop
    omarchy-notification-send -g "$ICON_LOCK" "Auto-rotate disabled"
  else
    start
    omarchy-notification-send -g "$ICON_AUTO" "Auto-rotate enabled"
  fi
}

status() {
  if is_locked; then
    printf '{"text":"%s","class":"locked","tooltip":"Orientation locked — click for auto-rotate"}\n' "$ICON_LOCK"
  else
    printf '{"text":"%s","class":"auto","tooltip":"Auto-rotate on — click to lock"}\n' "$ICON_AUTO"
  fi
}

case "${1:-status}" in
  start)   start ;;
  stop)    stop ;;
  toggle)  toggle ;;
  status)  status ;;
  _daemon) _daemon ;;
  *) echo "usage: orientation {start|stop|toggle|status}" >&2; exit 1 ;;
esac
