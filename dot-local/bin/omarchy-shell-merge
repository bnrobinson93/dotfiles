#!/usr/bin/env bash
set -euo pipefail

# Generates ~/.config/omarchy/shell.json by merging our overlay over Omarchy's
# packaged default.
#
# The shell takes a valid user shell.json as canonical and never deep-merges
# (shell.qml:74), so a tracked file inherits nothing when upstream changes its
# defaults. It also writes that same file back on ordinary interaction —
# right-clicking the battery, cycling the clock format, `omarchy plugin enable`
# — which is why the live file is generated state, not repo state. Whatever the
# shell persisted since the last run is discarded here; permanent means "in the
# overlay".
#
# The paths are overridable so the test suite can run the real merge against
# fixtures.

UPSTREAM=${OMARCHY_SHELL_DEFAULTS:-/usr/share/omarchy/config/omarchy/shell.json}
OVERLAY=${OMARCHY_SHELL_OVERLAY:-$HOME/.dotfiles/omarchy/shell.overlay.json}
LIVE=${OMARCHY_SHELL_CONFIG:-$HOME/.config/omarchy/shell.json}

log() { printf 'omarchy-shell-merge: %s\n' "$*"; }
die() { printf 'omarchy-shell-merge: %s\n' "$*" >&2; exit 1; }

[ -f "$UPSTREAM" ] || die "no upstream default at $UPSTREAM"
[ -f "$OVERLAY" ] || die "no overlay at $OVERLAY"

upstream_version=$(jq -r '.version // "none"' "$UPSTREAM")
overlay_version=$(jq -r '.version // "none"' "$OVERLAY")
if [ "$upstream_version" != "$overlay_version" ]; then
  die "upstream shell.json is version $upstream_version, overlay records $overlay_version.
Merging across a schema change would emit a plausible-looking file the shell may
misread. Reconcile $OVERLAY with $UPSTREAM by hand, then re-run."
fi

# Objects merge recursively with the overlay winning. Arrays of `{id: ...}`
# entries — bar.layout.* and plugins — keep our order, merge per-entry settings
# over upstream's, then append any upstream id we neither listed nor named in
# `remove`, so a widget added by an Omarchy release turns up on the bar on its
# own. Arrays of anything else are taken from the overlay wholesale.
merged=$(jq -n --slurpfile up "$UPSTREAM" --slurpfile ov "$OVERLAY" '
  ($up[0]) as $upstream
  | ($ov[0]) as $overlay
  | ($overlay.remove // []) as $remove
  | def merge($a; $b):
      if ($a | type) == "object" and ($b | type) == "object" then
        reduce ($b | keys_unsorted[]) as $k ($a; .[$k] = merge($a[$k]; $b[$k]))
      elif ($a | type) == "array" and ($b | type) == "array" then
        [ $b[]
          | select((.id? // null) as $i | $i == null or ($remove | index($i) | not))
          | . as $ours
          | ([$a[] | select(.id? != null and .id? == $ours.id?)] | first) as $theirs
          | if $theirs then merge($theirs; $ours) else $ours end
        ]
        + [ $a[]
            | select((.id? // null) as $i
                | $i != null
                and ($remove | index($i) | not)
                and ([$b[] | .id? // empty] | index($i) | not))
          ]
      else $b
      end;
    merge($upstream; $overlay | del(.remove))
')

overlay_json=$(cat "$OVERLAY")
while read -r section id; do
  [ -n "$id" ] && log "inherited new upstream entry '$id' into $section"
done < <(jq -rn --argjson merged "$merged" --argjson overlay "$overlay_json" '
  [["bar","layout","left"], ["bar","layout","center"], ["bar","layout","right"], ["plugins"]]
  | map(. as $path
      | ([($merged | getpath($path) // [])[] | .id? // empty]
         - [($overlay | getpath($path) // [])[] | .id? // empty])
      | map("\($path | join(".")) \(.)"))
  | flatten[]
')

formatted=$(printf '%s\n' "$merged" | jq --indent 2 -S .)

if [ -f "$LIVE" ] && printf '%s\n' "$formatted" | diff -q - "$LIVE" >/dev/null; then
  log "shell.json already matches the overlay"
  exit 0
fi

if [ -f "$LIVE" ]; then
  log "replacing shell.json; discarding anything below that the shell persisted"
  diff -u --label "live" --label "merged" <(jq -S . "$LIVE" 2>/dev/null || cat "$LIVE") <(printf '%s\n' "$formatted") || true
fi

# rename(2) over the path replaces a stow symlink with the real file, which is
# what we want here: the live file is ours to generate, not to link.
tmp="$LIVE.merge.$$"
printf '%s\n' "$formatted" >"$tmp"
mv -f "$tmp" "$LIVE"
log "wrote $LIVE"
