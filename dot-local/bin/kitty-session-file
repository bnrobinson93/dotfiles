#!/usr/bin/env bash
# kitty-session-file PATH — print the session file for PATH, generating it if absent.
#
# A repo-local <dir>/<name>.kitty-session wins if present. Otherwise the file
# lives in ~/.local/share/kitty/sessions and is generated once; edit it freely
# afterwards (startup commands, splits, layout) — it is never regenerated.

set -euo pipefail

SESSION_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/kitty/sessions

target=${1:?Usage: kitty-session-file PATH}
target=${target/#\~/$HOME}
target=${target%/}

[[ -d "$target" ]] || { printf "Not a directory: %s\n" "$target" >&2; exit 1; }

name=${target##*/}
name=${name#.}
name=${name//[^A-Za-z0-9_-]/-}

if [[ -f "$target/$name.kitty-session" ]]; then
  printf "%s\n" "$target/$name.kitty-session"
  exit 0
fi

mkdir -p "$SESSION_DIR"
path="$SESSION_DIR/$name.kitty-session"

# Two projects can share a basename; suffix with the parent directory.
if [[ -f "$path" ]] && ! grep -qxF "cd $target" "$path"; then
  parent=${target%/*}
  name="${parent##*/}-$name"
  name=${name//[^A-Za-z0-9_-]/-}
  path="$SESSION_DIR/$name.kitty-session"
fi

if [[ ! -f "$path" ]]; then
  cat > "$path" <<EOF
# generated by kitty-session-file — yours to edit
new_tab $name
cd $target
layout splits
launch
EOF
fi

printf "%s\n" "$path"
