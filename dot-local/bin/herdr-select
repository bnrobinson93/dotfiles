#!/usr/bin/env bash
# herdr-select — fzf picker for native Herdr workspaces and project folders

set -euo pipefail

BLACKLIST_PATTERNS=(
  '^code$'
  # Suffixes jj hands an agent workspace: -ai, -ai2, -orchestrator, -exp, -explore.
  '-(ai[0-9]*|orch.*|exp|explore)$'
)

PINNED_DIRS=(
  ~/.dotfiles
  ~/Documents/Vault
)

search_paths_command=$HOME/.local/bin/search-paths
SEARCH_PATHS=()
if [[ -x $search_paths_command ]]; then
  while IFS= read -r line; do
    SEARCH_PATHS+=("$line")
  done < <("$search_paths_command")
fi

is_blacklisted() {
  local name=$1
  local pattern

  for pattern in "${BLACKLIST_PATTERNS[@]}"; do
    [[ "$name" =~ $pattern ]] && return 0
  done

  return 1
}

if [[ "${1:-}" == "--preview" ]]; then
  type=${2:-}
  target=${3:-}

  case "$type" in
  workspace)
    herdr pane list --workspace "$target" | jq -r '
        .result.panes[]
        | "pane: \(.pane_id)\n  cwd: \(.cwd // "-")\n"
      '
    ;;
  folder)
    if command -v eza >/dev/null 2>&1; then
      eza --all --color=always "$target"
    else
      ls -la "$target"
    fi
    ;;
  remote)
    IFS='|' read -r machine_id wid ssh_target <<<"$target"
    printf 'remote workspace\n  machine: %s\n  target:  %s\n  id:      %s\n' \
      "$machine_id" "$ssh_target" "$wid"
    ;;
  esac

  exit 0
fi

workspace_rows() {
  herdr workspace list | jq -r '
    .result.workspaces[]
    | ["󰆍", .label, "workspace", .workspace_id]
    | @tsv
  '
}

directory_rows() {
  local include_blacklisted=${1:-false}

  {
    printf "%s\n" "${PINNED_DIRS[@]}"
    zoxide query -l 2>/dev/null || true
  } | sed 's:/*$::' |
    awk 'NF && !seen[$0]++' |
    while IFS= read -r path; do
      path=${path%/}
      name=${path##*/}
      [[ "$include_blacklisted" == true ]] || {
        is_blacklisted "$name" && continue
      }
      [[ -d "$path" ]] || continue
      printf "📁\t%s\tfolder\t%s\n" "$name" "$path"
    done
}

REMOTE_CACHE_TTL=30

remote_workspace_rows() {
  local machines_json count i
  machines_json=$(herdr machine list --json 2>/dev/null) || return 0
  [[ -n "$machines_json" ]] || return 0
  count=$(jq 'length' <<<"$machines_json" 2>/dev/null || echo 0)

  for ((i = 0; i < count; i++)); do
    local enabled id label target cache now mtime
    enabled=$(jq -r ".[$i].enabled" <<<"$machines_json")
    [[ "$enabled" == "true" ]] || continue
    id=$(jq -r ".[$i].id" <<<"$machines_json")
    label=$(jq -r ".[$i].label" <<<"$machines_json")
    target=$(jq -r ".[$i].target" <<<"$machines_json")

    cache="${TMPDIR:-/tmp}/herdr-select-remote-$id.json"
    now=$(date +%s)
    mtime=$(stat -c %Y "$cache" 2>/dev/null || echo 0)
    if [[ ! -f "$cache" || $((now - mtime)) -ge $REMOTE_CACHE_TTL ]]; then
      if herdr --machine "$id" workspace list >"$cache.tmp" 2>/dev/null; then
        mv "$cache.tmp" "$cache"
      else
        rm -f "$cache.tmp"
      fi
    fi
    [[ -f "$cache" ]] || continue

    jq -r --arg id "$id" --arg label "$label" --arg target "$target" '
      .result.workspaces[]
      | ["󰛳", (.label + " @" + $label), "remote", ($id + "|" + .workspace_id + "|" + $target)]
      | @tsv
    ' "$cache"
  done
}

folder_rows() {
  {
    printf "%s\n" "${PINNED_DIRS[@]}"
    if ((${#SEARCH_PATHS[@]})); then
      fd . "${SEARCH_PATHS[@]}" -d 1 -t d -E .Trash
    fi
  } | sed 's:/*$::' |
    awk 'NF && !seen[$0]++' |
    while IFS= read -r path; do
      path=${path%/}
      name=${path##*/}
      printf "📁\t%s\tfolder\t%s\n" "$name" "$path"
    done
}

script_path=$(printf '%q' "${BASH_SOURCE[0]}")
default_reload_cmd=$(printf '%q --default' "${BASH_SOURCE[0]}")
all_reload_cmd=$(printf '%q --all' "${BASH_SOURCE[0]}")
workspace_reload_cmd=$(printf '%q --workspaces' "${BASH_SOURCE[0]}")
folder_reload_cmd=$(printf '%q --folders' "${BASH_SOURCE[0]}")
close_workspace_cmd=$(printf '%q --close-workspace {3} {4}' "${BASH_SOURCE[0]}")

case "${1:-}" in
--default)
  {
    workspace_rows
    directory_rows
  }
  exit 0
  ;;
--all)
  {
    workspace_rows
    directory_rows true
  }
  exit 0
  ;;
--workspaces)
  workspace_rows
  remote_workspace_rows
  exit 0
  ;;
--folders)
  folder_rows
  exit 0
  ;;
--close-workspace)
  if [[ "${2:-}" == "workspace" && -n "${3:-}" ]]; then
    herdr workspace close "$3" >/dev/null
  fi
  exit 0
  ;;
esac

# Title this popup pane when launched from the herdr keybinding.
[[ -n "${HERDR_PANE_ID:-}" ]] && herdr pane rename "$HERDR_PANE_ID" Workspaces >/dev/null 2>&1 || true

selection=$(
  {
    workspace_rows
    directory_rows
  } |
    fzf --no-sort --ansi \
      --height=100% \
      --delimiter '\t' --with-nth '1,2' \
      --border rounded --border-label ' herdr ' \
      --header '  ^a all ^w workspaces ^d close workspace ^p projects' \
      --bind "ctrl-a:change-prompt(⚡  )+reload($all_reload_cmd)" \
      --bind "ctrl-w:change-prompt(󰆍  )+reload($workspace_reload_cmd)" \
      --bind "ctrl-d:execute-silent($close_workspace_cmd)+reload($default_reload_cmd)" \
      --bind "ctrl-p:change-prompt(📁  )+reload($folder_reload_cmd)" \
      --preview-window 'down:45%' \
      --preview "$script_path --preview {3} {4}"
)

[[ -n "${selection:-}" ]] || exit 0

type=$(cut -f3 <<<"$selection")
target=$(cut -f4- <<<"$selection")

case "$type" in
workspace)
  herdr workspace focus "$target" >/dev/null
  ;;
remote)
  IFS='|' read -r machine_id wid ssh_target <<<"$target"
  herdr --machine "$machine_id" workspace focus "$wid" >/dev/null 2>&1 || true
  exec herdr --remote "$ssh_target"
  ;;
folder)
  herdr-workspace-at "$target"
  ;;
esac
