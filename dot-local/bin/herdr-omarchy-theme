#!/usr/bin/env bash
# herdr-omarchy-theme — mirror the effective Ghostty palette into Herdr-app.
# Omarchy's live ghostty.conf wins when it exists; elsewhere Ghostty reports its
# current merged configuration. The old command name stays for Omarchy hooks.
set -euo pipefail

home=${HERDR_APP_HOME:-$HOME/.config/herdr-app}
omarchy_src=${1:-${OMARCHY_THEME_FILE:-$HOME/.local/state/omarchy/current/theme/ghostty.conf}}
out_dir="$home/themes"
[[ -d $out_dir ]] || exit 0   # herdr-app not installed; nothing to do

source_file=$(mktemp)
defaults_file=$(mktemp)
trap 'rm -f "$source_file" "$defaults_file"' EXIT
if [[ -f $omarchy_src ]]; then
  theme_name=omarchy
  cp "$omarchy_src" "$source_file"
else
  ghostty_bin=$(command -v ghostty || true)
  if [[ -z $ghostty_bin && -x /Applications/Ghostty.app/Contents/MacOS/ghostty ]]; then
    ghostty_bin=/Applications/Ghostty.app/Contents/MacOS/ghostty
  fi
  if [[ -z $ghostty_bin ]]; then
    echo "ghostty not found; skipping Herdr theme sync" >&2
    exit 0
  fi
  theme_name=ghostty
  if ! "$ghostty_bin" +show-config --no-pager >"$source_file" ||
    ! "$ghostty_bin" +show-config --default --no-pager >"$defaults_file"; then
    echo "ghostty +show-config failed; skipping Herdr theme sync" >&2
    exit 0
  fi
fi

python3 - "$source_file" "$defaults_file" "$out_dir/$theme_name.json" <<'PY'
import json
import re
import sys

src, defaults, out = sys.argv[1:]

def parse(path):
    graphics = {}
    palette = {}
    for raw in open(path):
        line = raw.strip()
        match = re.match(r"palette\s*=\s*(\d+)\s*=\s*(#[0-9a-fA-F]{6})", line)
        if match:
            palette[int(match.group(1))] = match.group(2).lower()
            continue
        match = re.match(r"([a-z-]+)\s*=\s*(#[0-9a-fA-F]{6})", line)
        if match:
            graphics[match.group(1)] = match.group(2).lower()
    return graphics, palette

graphics, palette = parse(defaults)
current_graphics, current_palette = parse(src)
graphics.update(current_graphics)
palette.update(current_palette)

theme = {
    "background": graphics.get("background", "#1e1e2e"),
    "foreground": graphics.get("foreground", "#cdd6f4"),
    "selection": graphics.get("selection-background", palette.get(8, "#45475a")),
    "cursor": graphics.get("cursor-color", graphics.get("foreground", "#cdd6f4")),
    "ansi": [palette.get(i, "#000000") for i in range(16)],
}
with open(out, "w") as handle:
    json.dump(theme, handle, indent=2)
    handle.write("\n")
PY

# Do not undo a hand-picked theme on every `mise run stow`. The generated Ghostty
# theme owns the initial/default state; Omarchy remains an explicit override.
apply=1
state="$home/layouts/.state/main-jj.json"
if [[ $theme_name == ghostty && -f $state ]] && command -v jq >/dev/null 2>&1; then
  current=$(jq -r 'if (.theme | type) == "object" then (.theme.dark // "") else (.theme // "") end' "$state" 2>/dev/null || true)
  case $current in
    ""|atom-one-dark|ghostty|omarchy) ;;
    *) apply=0 ;;
  esac
fi

# Update the shown layout when the app is running; the generated file handles the next start.
if ((apply)) && command -v herdr-app >/dev/null 2>&1; then
  herdr-app do app.theme --name "$theme_name" >/dev/null 2>&1 || true
fi
