#!/bin/bash
search_paths_command=$HOME/.local/bin/search-paths
SEARCH_PATHS=()
if [[ -x $search_paths_command ]]; then
  while IFS= read -r line; do
    SEARCH_PATHS+=("$line")
  done < <("$search_paths_command")
fi

found_dirs=""
if ((${#SEARCH_PATHS[@]})); then
  if type fd >/dev/null 2>&1; then
    found_dirs=$(fd . "${SEARCH_PATHS[@]}" --min-depth 1 --max-depth 1 --type d)
  else
    found_dirs=$(find "${SEARCH_PATHS[@]}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
  fi
fi

# Agent workspaces, same exclusions as tmux-sessionizer / sesh.toml / kitty-select.
# WARN: fd ends a directory with a slash, so the strip has to come first, or the
# anchored exclusions match nothing.
selected_folder=$(printf '%s\n%s\n' "$HOME/.dotfiles" "$found_dirs" |
  sed -E 's:/*$::; /^$/d; /-(ai[0-9]*|orch[^/]*|exp|explore)$/d' | fzf)

if [[ -n $selected_folder ]]; then
  code -r "$selected_folder"
fi
