#!/bin/bash
SEARCH_PATHS=()
while IFS= read -r line; do
  SEARCH_PATHS+=("$line")
done < <(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' -e "s|^~|$HOME|" "${XDG_CONFIG_HOME:-$HOME/.config}/search-paths.txt")

if type fd >/dev/null 2>&1; then
  found_dirs=$(fd . "${SEARCH_PATHS[@]}" --min-depth 1 --max-depth 1 --type d)
else
  found_dirs=$(find "${SEARCH_PATHS[@]}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
fi

selected_folder=$(printf '%s\n%s\n' "$HOME/.dotfiles" "$found_dirs" | fzf)

if [[ -n $selected_folder ]]; then
  code -r "$selected_folder"
fi
