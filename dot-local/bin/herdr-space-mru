#!/usr/bin/env bash
# Keeps Herdr app spaces in last-used order for the space-mru mod (ctrl-b l).
# The app records only the shown space, so this follows view.json's `active`
# and writes one space id per line, most recent first.
set -euo pipefail

dir="$HOME/.config/herdr-app"
out="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-space-mru"
mkdir -p "$(dirname "$out")"
touch "$out"

record() {
  local active
  active=$(jq -r '.active // empty' "$dir/view.json" 2>/dev/null) || return 0
  [[ -n $active && $active != "$(head -n1 "$out")" ]] || return 0
  { echo "$active"; grep -vxF "$active" "$out" | head -n 49; } >"$out.tmp" || true
  mv "$out.tmp" "$out"
}

record
inotifywait -mq -e close_write,moved_to --format %f "$dir" | while read -r f; do
  [[ $f == view.json ]] && record
done
